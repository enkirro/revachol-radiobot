# Configuración común a TODOS los bots: /opt/revachol-radiobot/common.env (root:revachol-radiobot, 0640).
# Cada bot puede sobrescribir cualquier valor en su bot.env.

# --- Avisos por Telegram ------------------------------------------------------
# Token del bot (@BotFather) y chat donde escribe los avisos.
# Supergrupo: el chat_id empieza por -100. Si el supergrupo tiene temas, pon el
# ID del tema en THREAD_ID (sin él, escribe en "General").
# Truco: copia el enlace de un mensaje del tema -> https://t.me/c/1234567890/55/123
#   chat_id = -1001234567890   thread_id = 55
#RADIOBOT_TELEGRAM_BOT_TOKEN=123456789:AA...
#RADIOBOT_TELEGRAM_CHAT_ID=-1001234567890
#RADIOBOT_TELEGRAM_THREAD_ID=55

# No repetir el mismo tipo de aviso antes de N horas.
#RADIOBOT_NOTIFY_COOLDOWN_HOURS=12
