# Configuración de UN bot: /opt/revachol-radiobot/bots/<cuenta>/bot.env (root:revachol-radiobot, 0640).
# Lo que pongas aquí tiene prioridad sobre /opt/revachol-radiobot/common.env.
# Ningún valor de este fichero debe subirse a git.
#
# La carpeta del bot y la cuenta los fija systemd (RADIOBOT_HOME y
# RADIOBOT_ACCOUNT); no hace falta definirlos aquí.

# --- Rutas (por defecto, dentro de la carpeta del bot) ------------------------
#RADIOBOT_DATASET=/opt/revachol-radiobot/bots/<cuenta>/dataset.json
#RADIOBOT_STATE_DB=/opt/revachol-radiobot/bots/<cuenta>/state.db
#RADIOBOT_COOKIES=/opt/revachol-radiobot/bots/<cuenta>/cookies.json

# --- Formato del tuit ---------------------------------------------------------
# Campos del JSON y plantilla. {author} y {text} se sustituyen.
#RADIOBOT_AUTHOR_FIELD=Languages
#RADIOBOT_TEXT_FIELD=Translation
#RADIOBOT_TEMPLATE={author}: {text}

# Los textos de más de 280 caracteres se publican como hilo numerado "(1/2)",
# cortando entre frases. Si no cabe en este número de tuits ni cortando en
# comas o entre palabras, la entrada se omite.
#RADIOBOT_MAX_THREAD_PARTS=2
#RADIOBOT_THREAD_NUMBERING=true
#RADIOBOT_THREAD_DELAY=8

# Al agotar el dataset, empezar un ciclo nuevo (true) o parar y avisar (false).
#RADIOBOT_RECYCLE=true

# --- Cliente X ----------------------------------------------------------------
#RADIOBOT_LANGUAGE=es-ES
# Huella TLS de navegador (curl_cffi). Vacío para desactivar.
#RADIOBOT_IMPERSONATE=chrome124
# User-Agent. Por defecto, uno de Chrome de la misma versión que la huella TLS
# (con chrome124: Chrome 124 en Windows). Debe ser coherente con IMPERSONATE.
#RADIOBOT_USER_AGENT=
# Proxy opcional, p. ej. socks5://usuario:clave@host:1080
#RADIOBOT_PROXY=

# Poner a true para probar sin publicar.
#RADIOBOT_DRY_RUN=false

# --- Avisos por Telegram -------------------------------------------------------
# Se configuran en /opt/revachol-radiobot/common.env. Para que este bot avise en otro
# tema del supergrupo, sobrescribe aquí solo el tema:
#RADIOBOT_TELEGRAM_THREAD_ID=
